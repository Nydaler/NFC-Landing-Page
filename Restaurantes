        function handleLogin() {
            const user = document.getElementById('login-user').value.trim();
            const pass = document.getElementById('login-pass').value.trim();
            
            if (user === ADMIN_USER && pass === ADMIN_PASS) {
                document.getElementById('login-user').value = '';
                document.getElementById('login-pass').value = '';
                showView('view-admin');
            } else {
                showToast("Usuario o contraseña incorrectos", "error");
            }
        }

        function saveWifiSettings() {
            const newSsid = document.getElementById('admin-wifi-ssid').value.trim();
            const newPass = document.getElementById('admin-wifi-pass').value.trim();
            
            if (!newSsid || !newPass) {
                showToast("El nombre y contraseña no pueden estar vacíos", "error");
                return;
            }
            wifiData = { ssid: newSsid, pass: newPass };
            localStorage.setItem('restaurant_wifi_prod', JSON.stringify(wifiData));
            showToast("Configuración Wi-Fi guardada", "success");
        }

        function renderGameCategories() {
            const container = document.getElementById('game-categories');
            container.innerHTML = '';
            for (let key in gameDB) {
                const cat = gameDB[key];
                const isActive = activeGameCategory === key;
                const activeClass = isActive 
                    ? `${cat.bg} ${cat.border} ${cat.text} shadow-md transform scale-105 border-2` 
                    : "bg-white border-gray-200 text-gray-500 hover:bg-gray-50 border shadow-sm";
                container.innerHTML += `
                    <button onclick="selectGameCategory('${key}')" class="flex-shrink-0 px-5 py-3 rounded-2xl font-bold text-sm flex items-center gap-2 transition-all cursor-pointer ${activeClass}">
                        <i class="ph-fill ${cat.icon} text-xl"></i> ${cat.name}
                    </button>`;
            }
        }

        function selectGameCategory(key) {
            activeGameCategory = key;
            const cat = gameDB[key];
            renderGameCategories();
            
            const icon = document.getElementById('game-icon');
            icon.className = `ph-fill ${cat.icon} text-5xl ${cat.text} transition-colors duration-300`;
            
            const card = document.getElementById('game-card');
            card.className = `w-full min-h-[16rem] rounded-[2rem] shadow-xl flex flex-col items-center justify-center p-8 text-center border-2 ${cat.border} ${cat.bg} relative transition-all duration-300`;
            
            const label = document.getElementById('game-category-label');
            label.innerText = cat.name;
            
            const btn = document.getElementById('game-btn');
            btn.className = `mt-10 text-white font-black text-xl px-8 py-5 rounded-2xl shadow-xl active:scale-95 transition-all w-full ${cat.btn} hover:opacity-90`;
            btn.disabled = false;
            
            nextQuestion(); 
        }

        function nextQuestion() {
            if (!activeGameCategory) return;
            const qElement = document.getElementById('game-question');
            const cat = gameDB[activeGameCategory];
            const questions = cat.questions;
            
            qElement.style.opacity = 0;
            qElement.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                const random = questions[Math.floor(Math.random() * questions.length)];
                qElement.innerText = random;
                qElement.style.opacity = 1;
                qElement.style.transform = 'translateY(0)';
                const textColorClass = cat.text.replace('600', '900').replace('500','900'); 
                qElement.className = `text-2xl font-bold ${textColorClass} leading-snug transition-all duration-300`;
            }, 300);
        }

