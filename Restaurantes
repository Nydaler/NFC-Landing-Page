<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menú Interactivo</title>
    <!-- Incluimos Tailwind pero respaldado con estilos propios para evitar fallos si se abre localmente -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        .view-section { display: none !important; }
        .is-flex { display: flex !important; }
        .is-block { display: block !important; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased selection:bg-brand-200">
    
    <script>
        tailwind.config = {
            theme: {
                extend: { colors: { brand: { 50: '#f0fdf4', 100: '#dcfce7', 200: '#bbf7d0', 500: '#22c55e', 600: '#16a34a' } } }
            }
        }
    </script>

    <!-- VISTA HOME -->
    <div id="view-home" class="view-section is-flex w-full max-w-md mx-auto bg-gray-50 min-h-screen flex-col shadow-2xl relative">
        <div class="h-64 bg-cover bg-center relative flex-shrink-0 rounded-b-3xl shadow-sm" style="background-image: url('https://placehold.co/800x600/333/fff?text=Restaurante');">
            <div class="absolute inset-0 bg-black/40 rounded-b-3xl"></div>
            <div class="absolute bottom-4 left-6 text-white">
                <h1 class="text-3xl font-black shadow-sm">El Gran Sabor</h1>
                <p class="text-sm font-medium flex items-center gap-1 mt-1"><i class="ph-fill ph-map-pin"></i> Mesa 12</p>
            </div>
        </div>

        <div class="px-6 py-8 flex flex-col gap-4 flex-1">
            <button onclick="showView('view-menu')" class="bg-gray-900 text-white p-5 rounded-3xl shadow-lg flex items-center justify-between active:scale-95 transition-transform">
                <div class="flex items-center gap-4">
                    <div class="bg-white/20 p-3 rounded-xl"><i class="ph-fill ph-book-open text-2xl"></i></div>
                    <div class="text-left">
                        <span class="font-black text-lg block">Ver Menú</span>
                        <span class="text-xs text-gray-300">Explora nuestros platos</span>
                    </div>
                </div>
                <i class="ph ph-caret-right text-gray-400 text-xl"></i>
            </button>

            <button onclick="showView('view-game-menu')" class="bg-blue-600 text-white p-5 rounded-3xl shadow-lg flex items-center justify-between active:scale-95 transition-transform">
                <div class="flex items-center gap-4">
                    <div class="bg-white/20 p-3 rounded-xl"><i class="ph-fill ph-game-controller text-2xl"></i></div>
                    <div class="text-left">
                        <span class="font-black text-lg block">Juegos de Mesa</span>
                        <span class="text-xs text-blue-200">Diviértete mientras esperas</span>
                    </div>
                </div>
                <i class="ph ph-caret-right text-blue-200 text-xl"></i>
            </button>

            <div class="grid grid-cols-2 gap-4 mt-2">
                <button onclick="showView('view-wifi')" class="bg-white border border-gray-200 text-gray-800 p-5 rounded-3xl shadow-sm flex flex-col items-center justify-center gap-3 active:scale-95 transition-transform">
                    <div class="bg-brand-50 p-3 rounded-full"><i class="ph-fill ph-wifi-high text-2xl text-brand-600"></i></div>
                    <span class="font-bold text-sm">Wi-Fi Gratis</span>
                </button>
                <button onclick="showView('view-reservas')" class="bg-white border border-gray-200 text-gray-800 p-5 rounded-3xl shadow-sm flex flex-col items-center justify-center gap-3 active:scale-95 transition-transform">
                    <div class="bg-orange-50 p-3 rounded-full"><i class="ph-fill ph-calendar-check text-2xl text-orange-500"></i></div>
                    <span class="font-bold text-sm text-center leading-tight">Reservas<br>y Preg.</span>
                </button>
            </div>
        </div>

        <div class="p-4 text-center mt-auto pb-6">
            <button onclick="showView('view-admin-login')" class="text-xs text-gray-400 underline font-medium">Acceso Restaurante (Admin)</button>
        </div>
    </div>

    <!-- VISTA MENU (Cliente) -->
    <div id="view-menu" class="view-section w-full max-w-md mx-auto bg-gray-50 min-h-screen flex-col pb-24 relative shadow-2xl">
        <div class="bg-white px-5 pt-6 pb-2 sticky top-0 z-20 shadow-sm rounded-b-2xl">
            <div class="flex items-center gap-3 mb-4">
                <button onclick="showView('view-home')" class="bg-gray-100 p-2 rounded-full text-gray-700 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
                <h2 class="font-black text-xl flex-1 text-gray-800">Menú</h2>
            </div>
            <div class="relative mb-3">
                <i class="ph ph-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                <input type="text" id="search-input" oninput="handleSearch()" placeholder="Buscar platos o ingredientes..." class="w-full bg-gray-100 text-sm rounded-full py-2.5 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-brand-500">
            </div>
            <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-2" id="filter-tags">
                <button id="tag-btn-vegan" onclick="toggleTag('vegan')" class="flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200 transition-colors">🌿 Vegano</button>
                <button id="tag-btn-gf" onclick="toggleTag('gf')" class="flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200 transition-colors">🌾 Sin TACC</button>
                <button id="tag-btn-spicy" onclick="toggleTag('spicy')" class="flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200 transition-colors">🌶️ Picante</button>
            </div>
        </div>
        
        <div class="px-4 py-4" id="menu-content"></div>

        <!-- Botón flotante de Tu Pedido -->
        <button id="cart-float-btn" onclick="openCart()" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-brand-600 text-white font-bold px-6 py-3 rounded-full shadow-2xl items-center gap-3 z-30 active:scale-95 transition-transform whitespace-nowrap">
            <i class="ph ph-list-checks text-xl"></i>
            <span id="cart-float-text">Tu Pedido (0)</span>
        </button>
    </div>

    <!-- MODAL TU PEDIDO -->
    <div id="cart-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex-col justify-end transition-opacity">
        <div class="w-full max-w-md mx-auto bg-white rounded-t-3xl min-h-[50vh] max-h-[80vh] flex flex-col relative animate-[slideUp_0.3s_ease-out]">
            <button onclick="closeCart()" class="absolute top-4 right-4 bg-gray-100 p-2 rounded-full text-gray-600 active:scale-95"><i class="ph ph-x"></i></button>
            <div class="p-6 border-b border-gray-100">
                <h2 class="text-2xl font-black text-gray-800">Tu Pedido</h2>
                <p class="text-sm text-gray-500 font-medium text-brand-600 mt-1">¡Leéle esta lista al mozo para pedir! 📝</p>
            </div>
            <div id="cart-items" class="p-6 overflow-y-auto flex-1 flex flex-col gap-4"></div>
            <div class="p-6 bg-gray-50 border-t border-gray-200 rounded-t-3xl shadow-[0_-10px_20px_-10px_rgba(0,0,0,0.1)]">
                <div class="flex justify-between items-end mb-4">
                    <span class="text-gray-500 font-medium">Total Estimado</span>
                    <span id="cart-total" class="text-3xl font-black text-gray-800">$0</span>
                </div>
                <button onclick="closeCart()" class="w-full bg-brand-600 text-white font-bold py-4 rounded-2xl shadow-lg active:scale-95 transition-transform">Volver al Menú</button>
            </div>
        </div>
    </div>

    <!-- VISTA ADMIN LOGIN -->
    <div id="view-admin-login" class="view-section w-full max-w-md mx-auto bg-gray-100 min-h-screen flex-col justify-center px-6 relative shadow-2xl">
        <button onclick="showView('view-home')" class="absolute top-6 left-6 bg-white p-2 rounded-full shadow-sm text-gray-800 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
        <div class="bg-white p-8 rounded-3xl shadow-xl w-full text-center border border-gray-100 animate-[slideUp_0.3s_ease-out]">
            <i class="ph-duotone ph-lock-key text-5xl text-gray-800 mb-4"></i>
            <h2 class="text-2xl font-black text-gray-800 mb-6">Acceso Restringido</h2>
            <div class="text-left mb-6 bg-blue-50 p-3 rounded-lg border border-blue-100 text-xs text-blue-600 font-medium">
                <i class="ph-fill ph-info"></i> Usa <b>admin</b> y <b>123456</b> para entrar en esta demo.
            </div>
            <input type="text" id="login-user" placeholder="Usuario" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mb-3 focus:outline-none focus:border-gray-900">
            <input type="password" id="login-pass" placeholder="Contraseña" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mb-6 focus:outline-none focus:border-gray-900">
            <button onclick="handleLogin()" class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl active:scale-95 transition-transform">Ingresar</button>
        </div>
    </div>

    <!-- VISTA ADMIN (Panel de Control) -->
    <div id="view-admin" class="view-section w-full max-w-md mx-auto bg-gray-100 min-h-screen shadow-2xl flex-col pb-10">
        <div class="bg-gray-900 text-white px-5 py-4 flex items-center gap-3 sticky top-0 z-10 shadow-md">
            <button onclick="showView('view-home')" class="bg-gray-800 p-2 rounded-full text-white active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
            <h2 class="font-bold text-lg flex-1">Panel de Control</h2>
        </div>
        <div class="p-5">
            <div class="bg-white p-5 rounded-2xl shadow-sm mb-6">
                <h3 class="font-bold text-gray-800 mb-4">Configuración Wi-Fi</h3>
                <div class="flex flex-col gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Nombre de la Red (SSID)</label>
                        <input type="text" id="admin-wifi-ssid" placeholder="Ej: MiRestaurante_WIFI" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Contraseña</label>
                        <input type="text" id="admin-wifi-pass" placeholder="Ej: clave123" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                    </div>
                    <button onclick="saveWifiSettings()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl mt-2 active:scale-95 transition-transform"><i class="ph ph-floppy-disk mr-2"></i>Guardar Wi-Fi</button>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm mb-6">
                <h3 class="font-bold text-gray-800 mb-4" id="admin-form-title">Agregar Nuevo Plato</h3>
                <div class="flex flex-col gap-3">
                    <input type="hidden" id="admin-id">
                    
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Categoría</label>
                        <select id="admin-category-select" onchange="checkNewCategory()" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900"></select>
                        <input type="text" id="admin-category-new" placeholder="Escribe la nueva categoría..." class="hidden w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-2 focus:outline-none focus:border-gray-900">
                    </div>

                    <div class="flex gap-2">
                        <div class="flex-1">
                            <label class="text-xs font-bold text-gray-500 uppercase">Nombre</label>
                            <input type="text" id="admin-name" placeholder="Ej: Milanesa..." class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                        </div>
                        <div class="w-24">
                            <label class="text-xs font-bold text-gray-500 uppercase">Orden</label>
                            <input type="number" id="admin-order" value="1" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                        </div>
                    </div>

                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Precio ($)</label>
                        <input type="number" id="admin-price" placeholder="Ej: 4500" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">Descripción</label>
                        <textarea id="admin-desc" placeholder="Ingredientes..." rows="2" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900"></textarea>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase">URL Imagen (Opcional)</label>
                        <input type="text" id="admin-image" placeholder="https://..." class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-sm mt-1 focus:outline-none focus:border-gray-900">
                    </div>
                    
                    <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 grid grid-cols-2 gap-2 mt-2">
                        <label class="flex items-center gap-2 text-sm font-medium cursor-pointer"><input type="checkbox" id="admin-featured" class="w-4 h-4 accent-gray-900"> ⭐ Destacado</label>
                        <label class="flex items-center gap-2 text-sm font-medium cursor-pointer"><input type="checkbox" id="admin-vegan" class="w-4 h-4 accent-green-500"> 🌿 Vegano</label>
                        <label class="flex items-center gap-2 text-sm font-medium cursor-pointer"><input type="checkbox" id="admin-gf" class="w-4 h-4 accent-amber-600"> 🌾 Sin TACC</label>
                        <label class="flex items-center gap-2 text-sm font-medium cursor-pointer"><input type="checkbox" id="admin-spicy" class="w-4 h-4 accent-red-500"> 🌶️ Picante</label>
                    </div>

                    <label class="flex items-center gap-2 text-sm font-bold text-red-600 bg-red-50 p-3 rounded-lg border border-red-200 mt-2 cursor-pointer">
                        <input type="checkbox" id="admin-outofstock" class="w-5 h-5 accent-red-600"> 🚫 Marcar como Agotado
                    </label>

                    <button onclick="saveDish()" class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl mt-2 active:scale-95 transition-transform">Guardar Plato</button>
                    <button onclick="resetAdminForm()" id="admin-cancel-btn" class="hidden w-full bg-gray-200 text-gray-700 font-bold py-2 rounded-xl mt-1 active:scale-95 transition-transform">Cancelar Edición</button>
                </div>
            </div>
            <h3 class="font-bold text-gray-800 mb-3 ml-1">Menú Actual</h3>
            <div id="admin-list" class="flex flex-col gap-3"></div>
        </div>
    </div>

    <!-- 1. Menú Principal de Juegos (HUB) -->
    <div id="view-game-menu" class="view-section w-full max-w-md mx-auto bg-blue-50 min-h-screen flex-col items-center relative px-6 py-10 shadow-2xl">
        <button onclick="showView('view-home')" class="absolute top-6 left-6 bg-white p-2 rounded-full shadow-sm text-gray-800 z-10 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
        
        <div class="text-center mt-12 mb-8">
            <i class="ph-duotone ph-game-controller text-6xl text-blue-500 mb-4"></i>
            <h2 class="text-3xl font-black text-gray-800">Sala de Juegos</h2>
            <p class="text-gray-500 text-sm mt-2">Elige un juego para disfrutar la espera</p>
        </div>

        <div class="w-full flex flex-col gap-4">
            <button onclick="showView('view-game-talk')" class="bg-white border-2 border-brand-100 p-5 rounded-2xl flex items-center gap-4 shadow-md active:scale-95 transition-transform text-left">
                <div class="bg-brand-50 text-brand-600 p-4 rounded-xl flex-shrink-0"><i class="ph ph-chat-centered-text text-3xl"></i></div>
                <div class="flex-1">
                    <h2 class="font-bold text-gray-800 text-lg">Charlas de Mesa</h2>
                    <p class="text-xs text-gray-500 leading-tight mt-1">Rompehielos, debates y preguntas curiosas.</p>
                </div>
                <i class="ph ph-caret-right text-xl text-gray-400"></i>
            </button>

            <button onclick="showView('view-game-trivia')" class="bg-white border-2 border-purple-100 p-5 rounded-2xl flex items-center gap-4 shadow-md active:scale-95 transition-transform text-left">
                <div class="bg-purple-50 text-purple-600 p-4 rounded-xl flex-shrink-0"><i class="ph ph-timer text-3xl"></i></div>
                <div class="flex-1">
                    <h2 class="font-bold text-gray-800 text-lg">¡Quiz Trivia!</h2>
                    <p class="text-xs text-gray-500 leading-tight mt-1">Pon a prueba tu conocimiento a contrarreloj.</p>
                </div>
                <i class="ph ph-caret-right text-xl text-gray-400"></i>
            </button>
        </div>
    </div>

    <!-- 2. Juego: Charlas de Mesa (Preguntas Disparadoras) -->
    <div id="view-game-talk" class="view-section w-full max-w-md mx-auto bg-brand-50 min-h-screen flex-col items-center relative px-6 py-8 shadow-2xl">
        <button onclick="showView('view-game-menu')" class="absolute top-6 left-6 bg-white p-2 rounded-full shadow-sm text-gray-800 z-10 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
        <div class="text-center mt-6 mb-6">
            <i id="game-icon" class="ph ph-cards text-5xl text-brand-500 mb-2 transition-colors duration-300"></i>
            <h2 class="text-2xl font-black text-gray-800">Charlas de Mesa</h2>
            <p class="text-gray-500 text-sm mt-1">Elige una categoría para empezar</p>
        </div>
        
        <div class="flex overflow-x-auto hide-scrollbar gap-3 w-full mb-6 pb-2 px-1" id="game-categories"></div>

        <div id="game-card" class="bg-white w-full h-64 rounded-3xl shadow-xl flex flex-col items-center justify-center p-8 text-center border-2 border-brand-100 relative transition-all duration-300">
            <span id="game-category-label" class="absolute top-4 text-xs font-bold uppercase tracking-wider text-brand-500 transition-colors">Categoría</span>
            <p id="game-question" class="text-xl font-bold text-gray-700 leading-snug transition-all duration-300">Toca una categoría para revelar la primera pregunta.</p>
        </div>
        
        <button onclick="nextQuestion()" id="game-btn" class="mt-8 bg-brand-600 text-white font-bold text-lg px-8 py-4 rounded-full shadow-lg active:scale-95 transition-transform w-full opacity-50 cursor-not-allowed" disabled>Siguiente Pregunta</button>
    </div>

    <!-- 3. Juego: Quiz Trivia -->
    <div id="view-game-trivia" class="view-section w-full max-w-md mx-auto bg-purple-50 min-h-screen flex-col relative shadow-2xl">
        <div class="px-6 py-6 flex items-center justify-between z-10 sticky top-0 bg-purple-50/90 backdrop-blur">
            <button onclick="showView('view-game-menu')" class="bg-white p-2 rounded-full shadow-sm text-gray-800 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-lg"></i></button>
            <h2 class="text-xl font-black text-purple-900">Quiz Trivia</h2>
            <div class="w-9"></div>
        </div>

        <div id="trivia-categories-screen" class="px-6 flex flex-col flex-1 pb-10">
            <div class="text-center mb-8">
                <p class="text-purple-600 font-medium">Selecciona una categoría</p>
            </div>
            <div class="grid grid-cols-1 gap-4">
                <button onclick="startTrivia('historia')" class="bg-white border-2 border-orange-200 p-4 rounded-2xl flex items-center gap-4 shadow-sm active:scale-95 transition-transform">
                    <div class="bg-orange-100 text-orange-600 p-3 rounded-full"><i class="ph-fill ph-bank text-2xl"></i></div>
                    <span class="font-bold text-gray-800 text-lg flex-1 text-left">Historia</span>
                </button>
                <button onclick="startTrivia('deportes')" class="bg-white border-2 border-green-200 p-4 rounded-2xl flex items-center gap-4 shadow-sm active:scale-95 transition-transform">
                    <div class="bg-green-100 text-green-600 p-3 rounded-full"><i class="ph-fill ph-soccer-ball text-2xl"></i></div>
                    <span class="font-bold text-gray-800 text-lg flex-1 text-left">Deportes</span>
                </button>
                <button onclick="startTrivia('musica')" class="bg-white border-2 border-pink-200 p-4 rounded-2xl flex items-center gap-4 shadow-sm active:scale-95 transition-transform">
                    <div class="bg-pink-100 text-pink-600 p-3 rounded-full"><i class="ph-fill ph-music-notes text-2xl"></i></div>
                    <span class="font-bold text-gray-800 text-lg flex-1 text-left">Música</span>
                </button>
                <button onclick="startTrivia('entretenimiento')" class="bg-white border-2 border-yellow-200 p-4 rounded-2xl flex items-center gap-4 shadow-sm active:scale-95 transition-transform">
                    <div class="bg-yellow-100 text-yellow-600 p-3 rounded-full"><i class="ph-fill ph-film-slate text-2xl"></i></div>
                    <span class="font-bold text-gray-800 text-lg flex-1 text-left">Cine & TV</span>
                </button>
            </div>
        </div>

        <div id="trivia-active-screen" class="hidden px-6 flex-col flex-1 pb-10">
            <div class="flex justify-between items-center bg-white p-3 rounded-2xl shadow-sm border border-purple-100 mb-6">
                <span id="trivia-progress" class="text-sm font-bold text-purple-400">Pregunta 1/5</span>
                <div class="flex items-center gap-1 text-purple-600 font-black bg-purple-100 px-3 py-1 rounded-lg transition-colors" id="trivia-timer-container">
                    <i class="ph-fill ph-timer"></i> <span id="trivia-timer-text">15</span>s
                </div>
            </div>
            
            <div class="bg-white p-6 rounded-3xl shadow-md border-2 border-purple-200 mb-6 min-h-[160px] flex items-center justify-center text-center">
                <h3 id="trivia-question-text" class="text-xl font-bold text-gray-800 leading-snug">¿Pregunta?</h3>
            </div>

            <div id="trivia-options" class="flex flex-col gap-3"></div>
        </div>

        <div id="trivia-result-screen" class="hidden px-6 flex-col items-center justify-center flex-1 pb-10">
            <div class="bg-white p-8 rounded-3xl shadow-xl border-2 border-purple-200 text-center w-full">
                <i class="ph-duotone ph-trophy text-7xl text-yellow-400 mb-4"></i>
                <h2 class="text-3xl font-black text-gray-800 mb-2">¡Terminaste!</h2>
                <p class="text-gray-500 mb-6">Tu puntuación final es:</p>
                <div class="text-6xl font-black text-purple-600 mb-8"><span id="trivia-score-text">0</span><span class="text-3xl text-purple-300">/5</span></div>
                
                <button onclick="resetTriviaUI()" class="w-full bg-purple-600 text-white font-bold py-4 rounded-xl shadow-lg active:scale-95 transition-transform mb-3">Jugar Otra Vez</button>
