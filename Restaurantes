<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Menú Interactivo - El Gran Sabor</title>
    <!-- Tailwind CSS (CDN para despliegue rápido en Vercel) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <style>
        /* Clases utilitarias para el manejo de vistas */
        .view-section { display: none !important; }
        .is-flex { display: flex !important; }
        .is-block { display: block !important; }
        
        /* Ocultar scrollbar pero permitir scroll */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Animaciones suaves */
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        /* Ajustes para evitar zoom en inputs en iOS */
        input, select, textarea { font-size: 16px !important; }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased selection:bg-brand-200">
    
    <script>
        // Configuración de la paleta de colores de Tailwind
        tailwind.config = {
            theme: {
                extend: { 
                    colors: { 
                        brand: { 50: '#f0fdf4', 100: '#dcfce7', 200: '#bbf7d0', 500: '#22c55e', 600: '#16a34a' } 
                    } 
                }
            }
        }
    </script>

    <!-- VISTA HOME -->
    <div id="view-home" class="view-section is-flex w-full max-w-md mx-auto bg-gray-50 min-h-screen flex-col shadow-2xl relative">
        <div class="h-64 bg-cover bg-center relative flex-shrink-0 rounded-b-3xl shadow-sm" style="background-image: url('https://placehold.co/800x600/111/fff?text=El+Gran+Sabor');">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent rounded-b-3xl"></div>
            <div class="absolute bottom-6 left-6 text-white">
                <h1 class="text-4xl font-black shadow-sm tracking-tight">El Gran Sabor</h1>
                <p class="text-sm font-medium flex items-center gap-1 mt-2 bg-black/40 inline-flex px-3 py-1 rounded-full backdrop-blur-sm"><i class="ph-fill ph-map-pin text-brand-500"></i> Escaneado en Mesa 12</p>
            </div>
        </div>

        <div class="px-6 py-8 flex flex-col gap-4 flex-1 z-10 -mt-6">
            <button onclick="showView('view-menu')" class="bg-gray-900 text-white p-5 rounded-3xl shadow-xl flex items-center justify-between active:scale-95 transition-transform hover:bg-gray-800 border border-gray-700">
                <div class="flex items-center gap-4">
                    <div class="bg-white/10 p-3 rounded-2xl"><i class="ph-fill ph-book-open text-3xl text-brand-500"></i></div>
                    <div class="text-left">
                        <span class="font-black text-xl block">Ver Menú</span>
                        <span class="text-sm text-gray-400 font-medium">Explora nuestros platos</span>
                    </div>
                </div>
                <i class="ph ph-caret-right text-gray-500 text-xl"></i>
            </button>

            <button onclick="showView('view-game-menu')" class="bg-indigo-600 text-white p-5 rounded-3xl shadow-xl flex items-center justify-between active:scale-95 transition-transform hover:bg-indigo-700 border border-indigo-500">
                <div class="flex items-center gap-4">
                    <div class="bg-white/20 p-3 rounded-2xl"><i class="ph-fill ph-game-controller text-3xl text-indigo-200"></i></div>
                    <div class="text-left">
                        <span class="font-black text-xl block">Juegos de Mesa</span>
                        <span class="text-sm text-indigo-200 font-medium">Diviértete mientras esperas</span>
                    </div>
                </div>
                <i class="ph ph-caret-right text-indigo-300 text-xl"></i>
            </button>

            <div class="grid grid-cols-2 gap-4 mt-2">
                <button onclick="showView('view-wifi')" class="bg-white border-2 border-gray-100 text-gray-800 p-5 rounded-3xl shadow-md flex flex-col items-center justify-center gap-3 active:scale-95 transition-transform hover:border-blue-200">
                    <div class="bg-blue-50 p-4 rounded-full"><i class="ph-fill ph-wifi-high text-3xl text-blue-600"></i></div>
                    <span class="font-bold text-sm">Wi-Fi Gratis</span>
                </button>
                <button onclick="showView('view-reservas')" class="bg-white border-2 border-gray-100 text-gray-800 p-5 rounded-3xl shadow-md flex flex-col items-center justify-center gap-3 active:scale-95 transition-transform hover:border-orange-200">
                    <div class="bg-orange-50 p-4 rounded-full"><i class="ph-fill ph-calendar-check text-3xl text-orange-500"></i></div>
                    <span class="font-bold text-sm text-center leading-tight">Reservas<br>& Ayuda</span>
                </button>
            </div>
        </div>

        <div class="p-6 text-center mt-auto">
            <button onclick="showView('view-admin-login')" class="text-xs text-gray-400 hover:text-gray-600 underline font-medium transition-colors">Acceso Restaurante (Admin)</button>
        </div>
    </div>

    <!-- VISTA MENU (Cliente) -->
    <div id="view-menu" class="view-section w-full max-w-md mx-auto bg-gray-50 min-h-screen flex-col pb-24 relative shadow-2xl">
        <div class="bg-white px-5 pt-6 pb-2 sticky top-0 z-20 shadow-sm rounded-b-3xl">
            <div class="flex items-center gap-3 mb-4">
                <button onclick="showView('view-home')" class="bg-gray-100 p-2 rounded-full text-gray-700 active:scale-95 transition-transform hover:bg-gray-200"><i class="ph ph-arrow-left text-xl"></i></button>
                <h2 class="font-black text-2xl flex-1 text-gray-800 tracking-tight">Menú</h2>
            </div>
            <div class="relative mb-3">
                <i class="ph ph-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-lg"></i>
                <input type="text" id="search-input" oninput="handleSearch()" placeholder="Buscar platos o ingredientes..." class="w-full bg-gray-100 text-sm font-medium rounded-2xl py-3 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow border border-transparent focus:border-brand-200">
            </div>
            <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-3 pt-1" id="filter-tags">
                <button id="tag-btn-vegan" onclick="toggleTag('vegan')" class="flex-shrink-0 px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 border border-gray-200 shadow-sm transition-all flex items-center gap-1"><i class="ph-fill ph-leaf text-green-500 text-sm"></i> Vegano</button>
                <button id="tag-btn-gf" onclick="toggleTag('gf')" class="flex-shrink-0 px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 border border-gray-200 shadow-sm transition-all flex items-center gap-1"><i class="ph-fill ph-grains-slash text-amber-600 text-sm"></i> Sin TACC</button>
                <button id="tag-btn-spicy" onclick="toggleTag('spicy')" class="flex-shrink-0 px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 border border-gray-200 shadow-sm transition-all flex items-center gap-1"><i class="ph-fill ph-fire text-red-500 text-sm"></i> Picante</button>
            </div>
        </div>
        
        <div class="px-5 py-4" id="menu-content"></div>

        <!-- Botón flotante de Tu Pedido -->
        <button id="cart-float-btn" onclick="openCart()" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-gray-900 text-white font-bold px-8 py-4 rounded-full shadow-[0_10px_25px_-5px_rgba(0,0,0,0.3)] items-center gap-3 z-30 active:scale-95 transition-all hover:bg-black whitespace-nowrap border border-gray-700">
            <i class="ph ph-list-checks text-2xl text-brand-400"></i>
            <span id="cart-float-text" class="text-lg tracking-tight">Tu Pedido (0)</span>
        </button>
    </div>

    <!-- MODAL TU PEDIDO -->
    <div id="cart-modal" class="fixed inset-0 bg-black/70 z-50 hidden flex-col justify-end transition-opacity backdrop-blur-sm">
        <div class="w-full max-w-md mx-auto bg-white rounded-t-[2rem] min-h-[50vh] max-h-[85vh] flex flex-col relative animate-[slideUp_0.4s_cubic-bezier(0.16,1,0.3,1)]">
            <button onclick="closeCart()" class="absolute top-6 right-6 bg-gray-100 hover:bg-gray-200 p-2 rounded-full text-gray-600 active:scale-95 transition-colors"><i class="ph ph-x text-lg"></i></button>
            <div class="p-8 border-b border-gray-100">
                <h2 class="text-3xl font-black text-gray-800 tracking-tight">Tu Pedido</h2>
                <p class="text-sm font-bold text-brand-600 mt-2 bg-brand-50 inline-flex px-3 py-1 rounded-lg items-center gap-2">
                    <i class="ph-fill ph-info"></i> ¡Leéle esta lista al mozo para pedir!
                </p>
            </div>
            <div id="cart-items" class="p-6 overflow-y-auto flex-1 flex flex-col gap-4 bg-gray-50/50"></div>
            <div class="p-8 bg-white border-t border-gray-100 rounded-t-3xl shadow-[0_-15px_30px_-15px_rgba(0,0,0,0.1)]">
                <div class="flex justify-between items-end mb-6">
                    <span class="text-gray-500 font-bold uppercase tracking-wider text-sm">Total Estimado</span>
                    <span id="cart-total" class="text-4xl font-black text-gray-900 tracking-tight">$0</span>
                </div>
                <button onclick="closeCart()" class="w-full bg-brand-600 text-white font-bold text-lg py-4 rounded-2xl shadow-xl shadow-brand-500/30 active:scale-95 transition-transform hover:bg-brand-500">Volver al Menú</button>
            </div>
        </div>
    </div>

    <!-- VISTA ADMIN LOGIN -->
    <div id="view-admin-login" class="view-section w-full max-w-md mx-auto bg-gray-100 min-h-screen flex-col justify-center px-6 relative shadow-2xl">
        <button onclick="showView('view-home')" class="absolute top-6 left-6 bg-white p-3 rounded-full shadow-md text-gray-800 active:scale-95 transition-transform"><i class="ph ph-arrow-left text-xl"></i></button>
        <div class="bg-white p-8 rounded-[2rem] shadow-2xl w-full text-center border border-gray-100 animate-[fadeIn_0.3s_ease-out]">
            <div class="bg-gray-900 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
                <i class="ph-duotone ph-lock-key text-4xl text-white"></i>
            </div>
            <h2 class="text-2xl font-black text-gray-800 mb-2">Acceso Restringido</h2>
            <p class="text-gray-500 text-sm mb-6 font-medium">Panel de administración del menú</p>
            
            <div class="text-left mb-6 bg-blue-50 p-4 rounded-2xl border border-blue-100 text-xs text-blue-700 font-medium flex gap-2 items-start">
                <i class="ph-fill ph-info text-lg"></i> 
                <span>Para propósitos de demostración, usa el usuario <b>admin</b> y contraseña <b>123456</b>.</span>
            </div>

            <div class="flex flex-col gap-4 mb-8">
                <div class="relative">
                    <i class="ph ph-user absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-lg"></i>
                    <input type="text" id="login-user" placeholder="Usuario" class="w-full bg-gray-50 border border-gray-200 rounded-2xl py-4 pl-12 pr-4 text-sm font-medium focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition-colors">
                </div>
                <div class="relative">
                    <i class="ph ph-key absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-lg"></i>
                    <input type="password" id="login-pass" placeholder="Contraseña" class="w-full bg-gray-50 border border-gray-200 rounded-2xl py-4 pl-12 pr-4 text-sm font-medium focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition-colors">
                </div>
            </div>
            <button onclick="handleLogin()" class="w-full bg-gray-900 text-white font-bold text-lg py-4 rounded-2xl active:scale-95 transition-transform hover:bg-black shadow-lg">Ingresar al Panel</button>
        </div>
    </div>

    <!-- VISTA ADMIN (Panel de Control) -->
    <div id="view-admin" class="view-section w-full max-w-md mx-auto bg-gray-100 min-h-screen shadow-2xl flex-col pb-10">
        <div class="bg-gray-900 text-white px-6 py-5 flex items-center gap-4 sticky top-0 z-20 shadow-lg">
            <button onclick="showView('view-home')" class="bg-gray-800 hover:bg-gray-700 p-2 rounded-full text-white active:scale-95 transition-colors"><i class="ph ph-arrow-left text-xl"></i></button>
            <h2 class="font-bold text-xl flex-1 tracking-tight">Panel de Control</h2>
        </div>
        
        <div class="p-5">
            <div class="bg-white p-6 rounded-3xl shadow-sm mb-6 border border-gray-200">
                <h3 class="font-black text-gray-800 text-lg mb-5 flex items-center gap-2"><i class="ph-fill ph-wifi-high text-blue-500"></i> Configuración Wi-Fi</h3>
                <div class="flex flex-col gap-4">
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Nombre de la Red (SSID)</label>
                        <input type="text" id="admin-wifi-ssid" placeholder="Ej: MiRestaurante_WIFI" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Contraseña</label>
                        <input type="text" id="admin-wifi-pass" placeholder="Ej: clave123" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                    </div>
                    <button onclick="saveWifiSettings()" class="w-full bg-blue-600 text-white font-bold py-3.5 rounded-xl mt-2 active:scale-95 transition-transform shadow-md hover:bg-blue-700"><i class="ph ph-floppy-disk mr-2"></i>Guardar Red Wi-Fi</button>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl shadow-sm mb-8 border border-gray-200">
                <h3 class="font-black text-gray-800 text-lg mb-5 flex items-center gap-2" id="admin-form-title"><i class="ph-fill ph-plus-circle text-brand-500"></i> Agregar Nuevo Plato</h3>
                <div class="flex flex-col gap-4">
                    <input type="hidden" id="admin-id">
                    
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Categoría</label>
                        <select id="admin-category-select" onchange="checkNewCategory()" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900"></select>
                        <input type="text" id="admin-category-new" placeholder="Escribe la nueva categoría..." class="hidden w-full bg-blue-50 border border-blue-200 rounded-xl p-3 text-sm mt-2 font-medium focus:outline-none focus:border-blue-500 transition-all">
                    </div>

                    <div class="flex gap-3">
                        <div class="flex-1">
                            <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Nombre del Plato</label>
                            <input type="text" id="admin-name" placeholder="Ej: Milanesa a la Suiza..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900">
                        </div>
                        <div class="w-24">
                            <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1" title="Menor número aparece primero">Orden ℹ️</label>
                            <input type="number" id="admin-order" value="1" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900 text-center">
                        </div>
                    </div>

                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Precio Final ($)</label>
                        <input type="number" id="admin-price" placeholder="Ej: 4500" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900">
                    </div>
                    
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">Descripción / Ingredientes</label>
                        <textarea id="admin-desc" placeholder="Detalle de los ingredientes que componen el plato..." rows="3" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900"></textarea>
                    </div>
                    
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase tracking-wider ml-1">URL de la Imagen (Opcional)</label>
                        <input type="text" id="admin-image" placeholder="https://..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-sm mt-1 font-medium focus:outline-none focus:border-gray-900 text-gray-500">
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 grid grid-cols-2 gap-3 mt-2">
                        <label class="flex items-center gap-2 text-sm font-bold cursor-pointer"><input type="checkbox" id="admin-featured" class="w-5 h-5 accent-gray-900 rounded"> ⭐ Destacado</label>
                        <label class="flex items-center gap-2 text-sm font-bold cursor-pointer text-green-700"><input type="checkbox" id="admin-vegan" class="w-5 h-5 accent-green-600 rounded"> 🌿 Vegano</label>
                        <label class="flex items-center gap-2 text-sm font-bold cursor-pointer text-amber-700"><input type="checkbox" id="admin-gf" class="w-5 h-5 accent-amber-600 rounded"> 🌾 Sin TACC</label>
                        <label class="flex items-center gap-2 text-sm font-bold cursor-pointer text-red-700"><input type="checkbox" id="admin-spicy" class="w-5 h-5 accent-red-600 rounded"> 🌶️ Picante</label>
                    </div>

                    <label class="flex items-center gap-3 text-sm font-black text-red-600 bg-red-50 p-4 rounded-2xl border border-red-200 mt-2 cursor-pointer shadow-sm hover:bg-red-100 transition-colors">
                        <input type="checkbox" id="admin-outofstock" class="w-6 h-6 accent-red-600 rounded"> 🚫 MARCAR COMO AGOTADO
                    </label>

                    <button onclick="saveDish()" class="w-full bg-gray-900 text-white font-bold text-lg py-4 rounded-2xl mt-4 active:scale-95 transition-transform shadow-lg hover:bg-black">Guardar Plato en el Menú</button>
                    <button onclick="resetAdminForm()" id="admin-cancel-btn" class="hidden w-full bg-white border-2 border-gray-200 text-gray-700 font-bold py-3 rounded-2xl mt-2 active:scale-95 transition-transform hover:bg-gray-50">Cancelar Edición</button>
                </div>
            </div>
            
            <div class="flex items-center justify-between mb-4 px-1">
                <h3 class="font-black text-gray-800 text-xl">Menú Actual</h3>
                <span class="text-xs font-bold bg-gray-200 text-gray-600 px-3 py-1 rounded-full" id="admin-total-items">0 items</span>
            </div>
            <div id="admin-list" class="flex flex-col gap-3"></div>
        </div>
    </div>

    <!-- 1. Menú Principal de Juegos (HUB) -->
    <div id="view-game-menu" class="view-section w-full max-w-md mx-auto bg-indigo-50 min-h-screen flex-col items-center relative px-6 py-10 shadow-2xl">
        <button onclick="showView('view-home')" class="absolute top-6 left-6 bg-white p-2 rounded-full shadow-md text-gray-800 z-10 active:scale-95 transition-transform hover:bg-gray-100"><i class="ph ph-arrow-left text-xl"></i></button>
        
        <div class="text-center mt-12 mb-10 w-full animate-[fadeIn_0.5s_ease-out]">
            <div class="bg-indigo-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-4 shadow-inner">
                <i class="ph-duotone ph-game-controller text-6xl text-indigo-600"></i>
            </div>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight">Sala de Juegos</h2>
            <p class="text-indigo-600 font-medium text-sm mt-2">Elige un juego para disfrutar la espera</p>
        </div>

        <div class="w-full flex flex-col gap-5">
            <button onclick="showView('view-game-talk')" class="bg-white border border-brand-200 p-6 rounded-[2rem] flex items-center gap-5 shadow-lg active:scale-95 transition-all text-left hover:shadow-xl hover:-translate-y-1">
                <div class="bg-brand-50 text-brand-500 p-4 rounded-2xl flex-shrink-0 shadow-inner"><i class="ph-fill ph-chat-centered-text text-4xl"></i></div>
                <div class="flex-1">
                    <h2 class="font-black text-gray-900 text-xl mb-1">Charlas de Mesa</h2>
                    <p class="text-sm text-gray-500 font-medium leading-tight">Preguntas, rompehielos y debates.</p>
                </div>
                <i class="ph ph-caret-right text-2xl text-gray-300"></i>
            </button>

            <button onclick="showView('view-game-trivia')" class="bg-white border border-purple-200 p-6 rounded-[2rem] flex items-center gap-5 shadow-lg active:scale-95 transition-all text-left hover:shadow-xl hover:-translate-y-1">
                <div class="bg-purple-50 text-purple-500 p-4 rounded-2xl flex-shrink-0 shadow-inner"><i class="ph-fill ph-timer text-4xl"></i></div>
                <div class="flex-1">
                    <h2 class="font-black text-gray-900 text-xl mb-1">¡Quiz Trivia!</h2>
                    <p class="text-sm text-gray-500 font-medium leading-tight">Pon a prueba tu conocimiento contra reloj.</p>
                </div>
                <i class="ph ph-caret-right text-2xl text-gray-300"></i>
            </button>
        </div>
    </div>

    <!-- 2. Juego: Charlas de Mesa (Preguntas Disparadoras) -->
    <div id="view-game-talk" class="view-section w-full max-w-md mx-auto bg-brand-50 min-h-screen flex-col items-center relative px-6 py-8 shadow-2xl">
        <button onclick="showView('view-game-menu')" class="absolute top-6 left-6 bg-white p-2 rounded-full shadow-md text-gray-800 z-10 active:scale-95 transition-transform hover:bg-gray-100"><i class="ph ph-arrow-left text-xl"></i></button>
        <div class="text-center mt-6 mb-8 w-full">
            <div class="bg-white/50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 shadow-sm">
                <i id="game-icon" class="ph-fill ph-cards text-5xl text-brand-500 transition-colors duration-300"></i>
            </div>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight">Charlas de Mesa</h2>
            <p class="text-brand-700 font-medium text-sm mt-1">Elige una categoría para empezar</p>
        </div>
        
        <div class="flex overflow-x-auto hide-scrollbar gap-3 w-full mb-8 pb-2 px-1" id="game-categories"></div>

        <div id="game-card" class="bg-white w-full min-h-[16rem] rounded-[2rem] shadow-xl flex flex-col items-center justify-center p-8 text-center border-2 border-brand-100 relative transition-all duration-300">
            <span id="game-category-label" class="absolute top-5 text-xs font-black uppercase tracking-widest text-brand-500 transition-colors bg-brand-50 px-3 py-1 rounded-full">Categoría</span>
            <p id="game-question" class="text-2xl font-bold text-gray-800 leading-snug transition-all duration-300">Toca una categoría para revelar la primera pregunta.</p>
        </div>
        
        <button onclick="nextQuestion()" id="game-btn" class="mt-10 bg-brand-600 text-white font-black text-xl px-8 py-5 rounded-2xl shadow-xl shadow-brand-500/30 active:scale-95 transition-all w-full opacity-50 cursor-not-allowed hover:bg-brand-500" disabled>Siguiente Pregunta</button>
    </div>

    <!-- 3. Juego: Quiz Trivia -->
    <div id="view-game-trivia" class="view-section w-full max-w-md mx-auto bg-purple-50 min-h-screen flex-col relative shadow-2xl">
