            localStorage.setItem('restaurant_wifi_v2', JSON.stringify(wifiData));
            showToast("Configuración Wi-Fi guardada", "success");
        }

        function renderGameCategories() {
            const container = document.getElementById('game-categories');
            container.innerHTML = '';
            for (let key in gameDB) {
                const cat = gameDB[key];
                const isActive = activeGameCategory === key;
                const activeClass = isActive ? `${cat.bg} ${cat.border} ${cat.text} shadow-md transform scale-105` : "bg-white border-gray-100 text-gray-400 hover:bg-gray-50";
                container.innerHTML += `
                    <button onclick="selectGameCategory('${key}')" class="flex-shrink-0 px-5 py-2.5 rounded-2xl font-bold text-sm flex items-center gap-2 border-2 transition-all cursor-pointer ${activeClass}">
                        <i class="ph ${cat.icon} text-xl"></i> ${cat.name}
                    </button>`;
            }
        }

        function selectGameCategory(key) {
            activeGameCategory = key;
            const cat = gameDB[key];
            renderGameCategories();
            
            document.getElementById('game-icon').className = `ph ${cat.icon} text-5xl ${cat.text} mb-2 transition-colors duration-300`;
            document.getElementById('game-card').className = `w-full h-64 rounded-3xl shadow-xl flex flex-col items-center justify-center p-8 text-center border-2 ${cat.border} ${cat.bg} relative transition-all duration-300`;
            
            const label = document.getElementById('game-category-label');
            label.innerText = cat.name;
            label.className = `absolute top-4 text-xs font-black uppercase tracking-wider ${cat.text} transition-colors`;
            
            const btn = document.getElementById('game-btn');
            btn.className = `mt-8 text-white font-bold text-lg px-8 py-4 rounded-full shadow-xl active:scale-95 transition-all w-full ${cat.btn}`;
            btn.disabled = false;
            
            nextQuestion(); 
        }

        function nextQuestion() {
            if (!activeGameCategory) return;
            const qElement = document.getElementById('game-question');
            const cat = gameDB[activeGameCategory];
            const questions = cat.questions;
            
            qElement.style.opacity = 0;
            qElement.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                const random = questions[Math.floor(Math.random() * questions.length)];
                qElement.innerText = random;
                qElement.style.opacity = 1;
                qElement.style.transform = 'translateY(0)';
                const textColorClass = cat.text.replace('600', '800'); 
                qElement.className = `text-xl font-bold ${textColorClass} leading-snug transition-all duration-300`;
            }, 300);
        }

        function resetTriviaUI() {
            clearInterval(triviaState.interval);
            document.getElementById('trivia-categories-screen').classList.remove('hidden');
            document.getElementById('trivia-categories-screen').classList.add('flex');
            document.getElementById('trivia-active-screen').classList.add('hidden');
            document.getElementById('trivia-active-screen').classList.remove('flex');
            document.getElementById('trivia-result-screen').classList.add('hidden');
            document.getElementById('trivia-result-screen').classList.remove('flex');
        }

        function startTrivia(categoryKey) {
            triviaState.category = categoryKey;
            triviaState.questions = [...triviaQuestions[categoryKey]].sort(() => Math.random() - 0.5);
            triviaState.qIndex = 0;
            triviaState.score = 0;

            document.getElementById('trivia-categories-screen').classList.add('hidden');
            document.getElementById('trivia-categories-screen').classList.remove('flex');
            document.getElementById('trivia-active-screen').classList.remove('hidden');
            document.getElementById('trivia-active-screen').classList.add('flex');

            loadTriviaQuestion();
        }

        function loadTriviaQuestion() {
            clearInterval(triviaState.interval);
            const currentQ = triviaState.questions[triviaState.qIndex];
            
            document.getElementById('trivia-progress').innerText = `Pregunta ${triviaState.qIndex + 1}/${triviaState.questions.length}`;
            document.getElementById('trivia-question-text').innerText = currentQ.q;
            
            const optionsContainer = document.getElementById('trivia-options');
            optionsContainer.innerHTML = '';
            
            currentQ.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full bg-white border border-purple-200 text-gray-700 font-bold py-4 px-6 rounded-2xl shadow-sm hover:bg-purple-50 active:scale-95 transition-all text-left flex justify-between items-center";
                btn.innerHTML = `<span>${opt}</span> <i class="ph ph-circle text-gray-300 text-xl trivia-icon"></i>`;
                btn.onclick = () => answerTrivia(idx, btn);
                optionsContainer.appendChild(btn);
            });

            triviaState.timer = 15;
            document.getElementById('trivia-timer-text').innerText = triviaState.timer;
            document.getElementById('trivia-timer-container').classList.replace('text-red-500', 'text-purple-600');
            document.getElementById('trivia-timer-container').classList.replace('bg-red-100', 'bg-purple-100');

            triviaState.interval = setInterval(() => {
                triviaState.timer--;
                document.getElementById('trivia-timer-text').innerText = triviaState.timer;
                
                if (triviaState.timer <= 5) {
                    document.getElementById('trivia-timer-container').classList.replace('text-purple-600', 'text-red-500');
                    document.getElementById('trivia-timer-container').classList.replace('bg-purple-100', 'bg-red-100');
                }

                if (triviaState.timer <= 0) {
                    clearInterval(triviaState.interval);
                    autoFailTrivia();
                }
            }, 1000);
        }

        function answerTrivia(selectedIndex, btnElement) {
            clearInterval(triviaState.interval);
            const currentQ = triviaState.questions[triviaState.qIndex];
            const buttons = document.getElementById('trivia-options').querySelectorAll('button');
            buttons.forEach(b => b.onclick = null);

            if (selectedIndex === currentQ.ans) {
                triviaState.score++;
                btnElement.classList.replace('border-purple-200', 'border-green-500');
                btnElement.classList.replace('text-gray-700', 'text-green-700');
                btnElement.classList.add('bg-green-50');
                btnElement.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-xl";
            } else {
                btnElement.classList.replace('border-purple-200', 'border-red-500');
                btnElement.classList.replace('text-gray-700', 'text-red-700');
                btnElement.classList.add('bg-red-50');
                btnElement.querySelector('.trivia-icon').className = "ph-fill ph-x-circle text-red-500 text-xl";
                
                const correctBtn = buttons[currentQ.ans];
                correctBtn.classList.replace('border-purple-200', 'border-green-500');
                correctBtn.classList.add('bg-green-50', 'text-green-700');
                correctBtn.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-xl";
            }
            setTimeout(nextTriviaQuestion, 1500);
        }

        function autoFailTrivia() {
            const currentQ = triviaState.questions[triviaState.qIndex];
            const buttons = document.getElementById('trivia-options').querySelectorAll('button');
            buttons.forEach(b => b.onclick = null);

            const correctBtn = buttons[currentQ.ans];
            correctBtn.classList.replace('border-purple-200', 'border-green-500');
            correctBtn.classList.add('bg-green-50', 'text-green-700');
            correctBtn.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-xl";

            setTimeout(nextTriviaQuestion, 1500);
        }

        function nextTriviaQuestion() {
            triviaState.qIndex++;
            if (triviaState.qIndex < triviaState.questions.length) {
                loadTriviaQuestion();
            } else {
                showTriviaResults();
            }
        }

        function showTriviaResults() {
            document.getElementById('trivia-active-screen').classList.add('hidden');
            document.getElementById('trivia-active-screen').classList.remove('flex');
            document.getElementById('trivia-result-screen').classList.remove('hidden');
            document.getElementById('trivia-result-screen').classList.add('flex');
            document.getElementById('trivia-score-text').innerText = triviaState.score;
        }

        function handleSearch() {
            searchQuery = document.getElementById('search-input').value.toLowerCase();
            updateClientMenu();
        }

        function toggleTag(tag) {
            const btn = document.getElementById(`tag-btn-${tag}`);
            if (activeTags.includes(tag)) {
                activeTags = activeTags.filter(t => t !== tag);
                btn.classList.replace('bg-gray-800', 'bg-gray-100');
                btn.classList.replace('text-white', 'text-gray-600');
            } else {
                activeTags.push(tag);
                btn.classList.replace('bg-gray-100', 'bg-gray-800');
                btn.classList.replace('text-gray-600', 'text-white');
            }
            updateClientMenu();
        }

        function updateClientMenu() {
            const container = document.getElementById('menu-content');
            container.innerHTML = '';

            let filteredData = menuData.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(searchQuery) || item.description.toLowerCase().includes(searchQuery);
                const matchesVegan = activeTags.includes('vegan') ? item.isVegan : true;
                const matchesGf = activeTags.includes('gf') ? item.isGlutenFree : true;
                const matchesSpicy = activeTags.includes('spicy') ? item.isSpicy : true;
                return matchesSearch && matchesVegan && matchesGf && matchesSpicy;
            });

            if (filteredData.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-gray-400"><i class="ph ph-magnifying-glass text-4xl mb-2"></i><p>No se encontraron platos.</p></div>`;
                return;
            }

            const featured = filteredData.filter(i => i.featured && !i.outOfStock).sort((a,b)=>a.order-b.order);
            if (featured.length > 0 && searchQuery === '' && activeTags.length === 0) {
                container.innerHTML += `<h3 class="font-black text-gray-800 mb-3 text-lg flex items-center gap-2"><i class="ph-fill ph-star text-yellow-500"></i> Recomendaciones del Chef</h3>`;
                let carousel = `<div class="flex overflow-x-auto hide-scrollbar gap-4 mb-8 pb-2">`;
                featured.forEach(item => {
                    carousel += `
                    <div class="flex-shrink-0 w-64 bg-white rounded-2xl shadow-md overflow-hidden relative border border-gray-100">
                        <div class="h-32 bg-cover bg-center" style="background-image: url('${item.image || 'https://placehold.co/400x300/eee/999?text=Sin+Imagen'}')"></div>
                        <div class="p-4">
                            <h4 class="font-bold text-gray-800 text-lg leading-tight mb-1">${item.name}</h4>
                            <p class="font-black text-brand-600">$${item.price}</p>
                        </div>
                        <button onclick="addToCart(${item.id})" class="absolute bottom-4 right-4 bg-gray-900 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg active:scale-95"><i class="ph ph-plus font-bold"></i></button>
                    </div>`;
                });
                carousel += `</div>`;
                container.innerHTML += carousel;
            }

            const categories = {};
            filteredData.sort((a,b)=>a.order-b.order).forEach(item => {
                if(!categories[item.category]) categories[item.category] = { name: item.category, items: [], minOrder: item.order };
                categories[item.category].items.push(item);
                if(item.order < categories[item.category].minOrder) categories[item.category].minOrder = item.order;
            });

            const sortedCategories = Object.values(categories).sort((a,b)=>a.minOrder - b.minOrder);

            sortedCategories.forEach(cat => {
                let html = `<h3 class="font-black text-gray-800 text-xl mb-4 mt-6 border-b-2 border-brand-500 pb-1 inline-block">${cat.name}</h3><div class="flex flex-col gap-4">`;
                
                cat.items.forEach(item => {
                    let tagsHtml = '';
                    if(item.isVegan) tagsHtml += `<span title="Vegano" class="text-green-500"><i class="ph-fill ph-leaf"></i></span>`;
                    if(item.isGlutenFree) tagsHtml += `<span title="Sin TACC" class="text-amber-600"><i class="ph-fill ph-grains-slash"></i></span>`;
                    if(item.isSpicy) tagsHtml += `<span title="Picante" class="text-red-500"><i class="ph-fill ph-fire"></i></span>`;
                    
                    const isOut = item.outOfStock;
                    const grayscale = isOut ? 'grayscale opacity-60' : '';
                    
                    html += `
                    <div class="bg-white p-3 rounded-2xl shadow-sm flex gap-4 ${grayscale} relative border border-gray-100">
                        <div class="w-24 h-24 rounded-xl bg-cover bg-center flex-shrink-0 border border-gray-100" style="background-image: url('${item.image || 'https://placehold.co/400x300/eee/999?text=Sin+Imagen'}')"></div>
                        <div class="flex-1 py-1 pr-2 flex flex-col">
                            <div class="flex justify-between items-start">
                                <h4 class="font-bold text-gray-800 leading-tight pr-2">${item.name}</h4>
                                <div class="flex gap-1 text-sm">${tagsHtml}</div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1 line-clamp-2 leading-relaxed">${item.description}</p>
                            <div class="mt-auto flex justify-between items-end">
                                ${isOut 
                                    ? `<span class="font-bold text-red-500 text-sm bg-red-50 border border-red-200 px-2 py-0.5 rounded-md mt-2">AGOTADO</span>`
                                    : `<p class="font-black text-brand-600">$${item.price}</p>`
                                }
                            </div>
                        </div>
                        ${!isOut ? `<button onclick="addToCart(${item.id})" class="absolute bottom-3 right-3 bg-gray-100 hover:bg-brand-50 text-brand-600 w-8 h-8 rounded-full flex items-center justify-center active:scale-95 transition-transform"><i class="ph ph-plus font-bold"></i></button>` : ''}
                    </div>`;
                });
                html += `</div>`;
                container.innerHTML += html;
            });
        }

        function addToCart(id) {
            const item = menuData.find(i => i.id === id);
            if(!item || item.outOfStock) return;
            const existing = orderCart.find(i => i.id === id);
            if(existing) { existing.qty++; } else { orderCart.push({...item, qty: 1}); }
            updateCartBtn();
            showToast(`Se añadió ${item.name}`, "success");
        }

        function updateCartBtn() {
            const btn = document.getElementById('cart-float-btn');
            const totalItems = orderCart.reduce((sum, item) => sum + item.qty, 0);
            if(totalItems > 0) {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
                document.getElementById('cart-float-text').innerText = `Tu Pedido (${totalItems})`;
            } else {
                btn.classList.add('hidden');
                btn.classList.remove('flex');
            }
        }

        function openCart() {
            renderCart();
            document.getElementById('cart-modal').classList.remove('hidden');
            document.getElementById('cart-modal').classList.add('flex');
        }

        function closeCart() {
            document.getElementById('cart-modal').classList.add('hidden');
            document.getElementById('cart-modal').classList.remove('flex');
        }

        function changeQty(id, delta) {
            const item = orderCart.find(i => i.id === id);
            if(!item) return;
            item.qty += delta;
            if(item.qty <= 0) { orderCart = orderCart.filter(i => i.id !== id); }
            renderCart();
            updateCartBtn();
            if(orderCart.length === 0) closeCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            container.innerHTML = '';
            let total = 0;
            orderCart.forEach(item => {
                total += item.price * item.qty;
                container.innerHTML += `
                <div class="flex justify-between items-center bg-gray-50 p-3 rounded-xl border border-gray-100">
                    <div class="flex-1">
                        <h4 class="font-bold text-gray-800 text-sm">${item.name}</h4>
                        <p class="text-brand-600 font-black text-xs">$${item.price}</p>
                    </div>
                    <div class="flex items-center gap-3 bg-white border border-gray-200 rounded-full px-2 py-1 shadow-sm">
                        <button onclick="changeQty(${item.id}, -1)" class="w-7 h-7 flex justify-center items-center rounded-full text-gray-500 active:bg-gray-100"><i class="ph ph-minus"></i></button>
                        <span class="font-bold text-sm w-4 text-center">${item.qty}</span>
                        <button onclick="changeQty(${item.id}, 1)" class="w-7 h-7 flex justify-center items-center rounded-full text-gray-500 active:bg-gray-100"><i class="ph ph-plus"></i></button>
                    </div>
                </div>`;
            });
            document.getElementById('cart-total').innerText = `$${total}`;
        }

        function populateCategorySelect() {
            const select = document.getElementById('admin-category-select');
            const categories = [...new Set(menuData.map(item => item.category))];
            select.innerHTML = '';
            categories.forEach(c => { select.innerHTML += `<option value="${c}">${c}</option>`; });
            select.innerHTML += `<option value="NEW">+ Nueva Categoría...</option>`;
            checkNewCategory();
        }

        function checkNewCategory() {
            const select = document.getElementById('admin-category-select');
            const newCatInput = document.getElementById('admin-category-new');
            if(select.value === 'NEW') {
                newCatInput.classList.remove('hidden');
                newCatInput.focus();
            } else {
                newCatInput.classList.add('hidden');
            }
        }

        function updateAdminList() {
            const list = document.getElementById('admin-list');
            list.innerHTML = '';
            [...menuData].sort((a,b)=>a.order-b.order).forEach(item => {
                const isOut = item.outOfStock ? '<span class="text-xs bg-red-100 text-red-600 px-1 rounded ml-1 border border-red-200">Agotado</span>' : '';
                list.innerHTML += `
                <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center">
                    <div class="flex flex-col flex-1 pr-2">
                        <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wide">${item.category} (Ord: ${item.order})</span>
                        <span class="font-bold text-gray-800 text-sm leading-tight">${item.name} ${item.featured ? '⭐' : ''} ${isOut}</span>
                        <span class="text-xs font-black text-brand-600">$${item.price}</span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="editDish(${item.id})" class="bg-blue-50 text-blue-600 p-2 rounded-lg border border-blue-100 active:scale-95"><i class="ph ph-pencil-simple"></i></button>
                        <button onclick="deleteDish(${item.id})" class="bg-red-50 text-red-600 p-2 rounded-lg border border-red-100 active:scale-95"><i class="ph ph-trash"></i></button>
                    </div>
                </div>`;
            });
        }

        function saveDish() {
            let catVal = document.getElementById('admin-category-select').value;
            if(catVal === 'NEW') {
                catVal = document.getElementById('admin-category-new').value.trim();
                if(!catVal) { showToast("Escribe un nombre para la categoría nueva", "error"); return; }
            }

            const name = document.getElementById('admin-name').value;
            const price = document.getElementById('admin-price').value;
            if(!name || !price) { showToast("El nombre y el precio son obligatorios", "error"); return; }

            const dish = {
                id: editingId || Date.now(), 
                category: catVal,
                name: name,
                order: parseInt(document.getElementById('admin-order').value) || 1,
                price: parseFloat(price),
                description: document.getElementById('admin-desc').value,
                image: document.getElementById('admin-image').value,
                featured: document.getElementById('admin-featured').checked,
                isVegan: document.getElementById('admin-vegan').checked,
                isGlutenFree: document.getElementById('admin-gf').checked,
                isSpicy: document.getElementById('admin-spicy').checked,
                outOfStock: document.getElementById('admin-outofstock').checked
            };

            if(editingId) {
                menuData = menuData.map(item => item.id === editingId ? dish : item);
            } else {
                menuData.push(dish);
            }

            localStorage.setItem('restaurant_menu_v2', JSON.stringify(menuData));
            showToast(editingId ? "Plato actualizado con éxito" : "Plato guardado con éxito", "success");
            
            resetAdminForm();
            updateAdminList();
            populateCategorySelect();
        }

        function editDish(id) {
            const dish = menuData.find(i => i.id === id);
            if(!dish) return;
            
            editingId = id;
            document.getElementById('admin-form-title').innerText = "Editar Plato";
            
            const select = document.getElementById('admin-category-select');
            if([...select.options].some(o => o.value === dish.category)) {
                select.value = dish.category;
                checkNewCategory();
            } else {
                select.value = 'NEW';
                checkNewCategory();
                document.getElementById('admin-category-new').value = dish.category;
            }

            document.getElementById('admin-name').value = dish.name;
            document.getElementById('admin-order').value = dish.order || 1;
            document.getElementById('admin-price').value = dish.price;
            document.getElementById('admin-desc').value = dish.description;
            document.getElementById('admin-image').value = dish.image || '';
            document.getElementById('admin-featured').checked = dish.featured;
            document.getElementById('admin-vegan').checked = dish.isVegan;
            document.getElementById('admin-gf').checked = dish.isGlutenFree;
            document.getElementById('admin-spicy').checked = dish.isSpicy;
            document.getElementById('admin-outofstock').checked = dish.outOfStock;
            
            document.getElementById('admin-cancel-btn').classList.remove('hidden');
            document.querySelector('#view-admin').scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetAdminForm() {
            editingId = null;
            document.getElementById('admin-form-title').innerText = "Agregar Nuevo Plato";
            document.getElementById('admin-category-new').value = '';
            document.getElementById('admin-name').value = '';
            document.getElementById('admin-order').value = '1';
            document.getElementById('admin-price').value = '';
            document.getElementById('admin-desc').value = '';
            document.getElementById('admin-image').value = '';
            document.getElementById('admin-featured').checked = false;
            document.getElementById('admin-vegan').checked = false;
            document.getElementById('admin-gf').checked = false;
            document.getElementById('admin-spicy').checked = false;
            document.getElementById('admin-outofstock').checked = false;
            document.getElementById('admin-cancel-btn').classList.add('hidden');
            populateCategorySelect();
        }

        function deleteDish(id) {
            if(confirm("¿Estás seguro de que deseas eliminar este plato definitivamente?")) {
                menuData = menuData.filter(item => item.id !== id);
                localStorage.setItem('restaurant_menu_v2', JSON.stringify(menuData));
                updateAdminList();
                showToast("Plato eliminado", "error");
            }
        }

        function copyWifi() {
            navigator.clipboard.writeText(wifiData.pass).then(() => { 
                showToast("Contraseña copiada al portapapeles", "success"); 
            }).catch(() => { 
                showToast("Error al copiar", "error"); 
            });
        }

        function showToast(msg, type="success") {
            const toast = document.createElement('div');
            const color = type === 'success' ? 'bg-gray-900' : 'bg-red-500';
            const icon = type === 'success' ? 'ph-check-circle' : 'ph-warning-circle';
            
            toast.className = `${color} text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-sm font-bold opacity-0 transition-all duration-300 transform -translate-y-4 border border-white/10`;
            toast.innerHTML = `<i class="ph-fill ${icon} text-xl"></i> ${msg}`;
            
            const container = document.getElementById('toast-container');
            container.appendChild(toast);
            
            requestAnimationFrame(() => { 
                toast.classList.remove('opacity-0', '-translate-y-4'); 
                toast.classList.add('opacity-100', 'translate-y-0'); 
            });
            
            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-4');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        window.onload = () => { 
            showView('view-home'); 
        }
    </script>
</body>
</html>
