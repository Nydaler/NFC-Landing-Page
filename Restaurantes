            document.getElementById('trivia-categories-screen').classList.add('flex');
            document.getElementById('trivia-active-screen').classList.add('hidden');
            document.getElementById('trivia-active-screen').classList.remove('flex');
            document.getElementById('trivia-result-screen').classList.add('hidden');
            document.getElementById('trivia-result-screen').classList.remove('flex');
        }

        function startTrivia(categoryKey) {
            triviaState.category = categoryKey;
            // Clonar y barajar preguntas
            triviaState.questions = [...triviaQuestions[categoryKey]].sort(() => Math.random() - 0.5);
            triviaState.qIndex = 0;
            triviaState.score = 0;

            document.getElementById('trivia-categories-screen').classList.add('hidden');
            document.getElementById('trivia-categories-screen').classList.remove('flex');
            document.getElementById('trivia-active-screen').classList.remove('hidden');
            document.getElementById('trivia-active-screen').classList.add('flex');

            loadTriviaQuestion();
        }

        function loadTriviaQuestion() {
            clearInterval(triviaState.interval);
            const currentQ = triviaState.questions[triviaState.qIndex];
            
            document.getElementById('trivia-progress').innerText = `Pregunta ${triviaState.qIndex + 1}/${triviaState.questions.length}`;
            document.getElementById('trivia-question-text').innerText = currentQ.q;
            
            const optionsContainer = document.getElementById('trivia-options');
            optionsContainer.innerHTML = '';
            
            currentQ.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full bg-white border-2 border-purple-100 text-gray-700 font-bold text-lg py-5 px-6 rounded-2xl shadow-sm hover:border-purple-300 hover:bg-purple-50 active:scale-95 transition-all text-left flex justify-between items-center";
                btn.innerHTML = `<span>${opt}</span> <i class="ph ph-circle text-gray-300 text-2xl trivia-icon"></i>`;
                btn.onclick = () => answerTrivia(idx, btn);
                optionsContainer.appendChild(btn);
            });

            triviaState.timer = 15;
            document.getElementById('trivia-timer-text').innerText = triviaState.timer;
            const timerContainer = document.getElementById('trivia-timer-container');
            timerContainer.className = "flex items-center gap-1.5 text-purple-700 font-black text-lg bg-purple-100 px-4 py-1.5 rounded-xl transition-colors";

            triviaState.interval = setInterval(() => {
                triviaState.timer--;
                document.getElementById('trivia-timer-text').innerText = triviaState.timer;
                
                if (triviaState.timer <= 5) {
                    timerContainer.className = "flex items-center gap-1.5 text-red-600 font-black text-lg bg-red-100 px-4 py-1.5 rounded-xl transition-colors animate-pulse";
                }

                if (triviaState.timer <= 0) {
                    clearInterval(triviaState.interval);
                    autoFailTrivia();
                }
            }, 1000);
        }

        function answerTrivia(selectedIndex, btnElement) {
            clearInterval(triviaState.interval);
            const currentQ = triviaState.questions[triviaState.qIndex];
            const buttons = document.getElementById('trivia-options').querySelectorAll('button');
            buttons.forEach(b => b.onclick = null); // Disable all

            if (selectedIndex === currentQ.ans) {
                triviaState.score++;
                btnElement.className = "w-full bg-green-50 border-2 border-green-500 text-green-800 font-bold text-lg py-5 px-6 rounded-2xl shadow-md transition-all text-left flex justify-between items-center";
                btnElement.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-2xl scale-110 transition-transform";
            } else {
                btnElement.className = "w-full bg-red-50 border-2 border-red-500 text-red-800 font-bold text-lg py-5 px-6 rounded-2xl shadow-md transition-all text-left flex justify-between items-center";
                btnElement.querySelector('.trivia-icon').className = "ph-fill ph-x-circle text-red-500 text-2xl scale-110 transition-transform";
                
                // Show correct
                const correctBtn = buttons[currentQ.ans];
                correctBtn.className = "w-full bg-green-50 border-2 border-green-500 text-green-800 font-bold text-lg py-5 px-6 rounded-2xl shadow-md transition-all text-left flex justify-between items-center";
                correctBtn.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-2xl";
            }
            setTimeout(nextTriviaQuestion, 1500);
        }

        function autoFailTrivia() {
            const currentQ = triviaState.questions[triviaState.qIndex];
            const buttons = document.getElementById('trivia-options').querySelectorAll('button');
            buttons.forEach(b => b.onclick = null);

            const correctBtn = buttons[currentQ.ans];
            correctBtn.className = "w-full bg-green-50 border-2 border-green-500 text-green-800 font-bold text-lg py-5 px-6 rounded-2xl shadow-md transition-all text-left flex justify-between items-center";
            correctBtn.querySelector('.trivia-icon').className = "ph-fill ph-check-circle text-green-500 text-2xl";

            setTimeout(nextTriviaQuestion, 1500);
        }

        function nextTriviaQuestion() {
            triviaState.qIndex++;
            if (triviaState.qIndex < triviaState.questions.length) {
                loadTriviaQuestion();
            } else {
                showTriviaResults();
            }
        }

        function showTriviaResults() {
            document.getElementById('trivia-active-screen').classList.add('hidden');
            document.getElementById('trivia-active-screen').classList.remove('flex');
            document.getElementById('trivia-result-screen').classList.remove('hidden');
            document.getElementById('trivia-result-screen').classList.add('flex');
            document.getElementById('trivia-score-text').innerText = triviaState.score;
        }

        function handleSearch() {
            searchQuery = document.getElementById('search-input').value.toLowerCase();
            updateClientMenu();
        }

        function toggleTag(tag) {
            const btn = document.getElementById(`tag-btn-${tag}`);
            if (activeTags.includes(tag)) {
                activeTags = activeTags.filter(t => t !== tag);
                btn.classList.replace('bg-gray-800', 'bg-white');
                btn.classList.replace('text-white', 'text-gray-600');
            } else {
                activeTags.push(tag);
                btn.classList.replace('bg-white', 'bg-gray-800');
                btn.classList.replace('text-gray-600', 'text-white');
            }
            updateClientMenu();
        }

        function updateClientMenu() {
            const container = document.getElementById('menu-content');
            container.innerHTML = '';

            // Filtrado múltiple
            let filteredData = menuData.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(searchQuery) || item.description.toLowerCase().includes(searchQuery);
                const matchesVegan = activeTags.includes('vegan') ? item.isVegan : true;
                const matchesGf = activeTags.includes('gf') ? item.isGlutenFree : true;
                const matchesSpicy = activeTags.includes('spicy') ? item.isSpicy : true;
                return matchesSearch && matchesVegan && matchesGf && matchesSpicy;
            });

            if (filteredData.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 text-gray-400">
                        <div class="bg-gray-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="ph-duotone ph-magnifying-glass text-4xl text-gray-400"></i>
                        </div>
                        <p class="font-medium">No se encontraron platos.</p>
                        <button onclick="document.getElementById('search-input').value=''; handleSearch();" class="mt-4 text-brand-600 font-bold underline">Limpiar búsqueda</button>
                    </div>`;
                return;
            }

            // Sección Destacados (Solo si no hay búsqueda activa)
            const featured = filteredData.filter(i => i.featured && !i.outOfStock).sort((a,b)=>a.order-b.order);
            if (featured.length > 0 && searchQuery === '' && activeTags.length === 0) {
                container.innerHTML += `<h3 class="font-black text-gray-900 mb-4 text-xl flex items-center gap-2"><i class="ph-fill ph-star text-yellow-500"></i> Recomendaciones del Chef</h3>`;
                let carousel = `<div class="flex overflow-x-auto hide-scrollbar gap-4 mb-8 pb-4 -mx-5 px-5">`;
                featured.forEach(item => {
                    carousel += `
                    <div class="flex-shrink-0 w-64 bg-white rounded-3xl shadow-[0_8px_20px_rgba(0,0,0,0.06)] overflow-hidden relative border border-gray-100 flex flex-col h-[280px]">
                        <div class="h-36 bg-cover bg-center" style="background-image: url('${item.image || 'https://placehold.co/400x300/eee/999?text=Sin+Imagen'}')"></div>
                        <div class="p-5 flex-1 flex flex-col">
                            <h4 class="font-black text-gray-900 text-lg leading-tight mb-1">${item.name}</h4>
                            <p class="font-black text-brand-600 text-xl mt-auto">$${item.price}</p>
                        </div>
                        <button onclick="addToCart(${item.id})" class="absolute bottom-4 right-4 bg-gray-900 hover:bg-brand-600 text-white w-10 h-10 rounded-full flex items-center justify-center shadow-lg active:scale-95 transition-colors"><i class="ph-bold ph-plus text-xl"></i></button>
                    </div>`;
                });
                carousel += `</div>`;
                container.innerHTML += carousel;
            }

            // Agrupación y Ordenamiento de Categorías
            const categories = {};
            filteredData.sort((a,b)=>a.order-b.order).forEach(item => {
                if(!categories[item.category]) categories[item.category] = { name: item.category, items: [], minOrder: item.order };
                categories[item.category].items.push(item);
                if(item.order < categories[item.category].minOrder) categories[item.category].minOrder = item.order;
            });

            const sortedCategories = Object.values(categories).sort((a,b)=>a.minOrder - b.minOrder);

            // Renderizado de Lista
            sortedCategories.forEach(cat => {
                let html = `<h3 class="font-black text-gray-900 text-2xl mb-5 mt-8 border-b-4 border-brand-500 pb-2 inline-block rounded-sm">${cat.name}</h3><div class="flex flex-col gap-4">`;
                
                cat.items.forEach(item => {
                    let tagsHtml = '';
                    if(item.isVegan) tagsHtml += `<span title="Vegano" class="bg-green-50 text-green-600 p-1 rounded-md"><i class="ph-fill ph-leaf text-sm"></i></span>`;
                    if(item.isGlutenFree) tagsHtml += `<span title="Sin TACC" class="bg-amber-50 text-amber-600 p-1 rounded-md"><i class="ph-fill ph-grains-slash text-sm"></i></span>`;
                    if(item.isSpicy) tagsHtml += `<span title="Picante" class="bg-red-50 text-red-600 p-1 rounded-md"><i class="ph-fill ph-fire text-sm"></i></span>`;
                    
                    const isOut = item.outOfStock;
                    const grayscale = isOut ? 'grayscale opacity-50' : '';
                    
                    html += `
                    <div class="bg-white p-4 rounded-[1.5rem] shadow-sm flex gap-4 ${grayscale} relative border border-gray-100 hover:shadow-md transition-shadow">
                        <div class="w-28 h-28 rounded-2xl bg-cover bg-center flex-shrink-0 border border-gray-100" style="background-image: url('${item.image || 'https://placehold.co/400x300/eee/999?text=Sin+Imagen'}')"></div>
                        <div class="flex-1 py-1 pr-1 flex flex-col">
                            <div class="flex justify-between items-start gap-2">
                                <h4 class="font-black text-gray-900 text-lg leading-tight">${item.name}</h4>
                            </div>
                            <div class="flex gap-1.5 mt-1.5 mb-1">${tagsHtml}</div>
                            <p class="text-sm text-gray-500 line-clamp-2 leading-snug font-medium">${item.description}</p>
                            <div class="mt-auto flex justify-between items-end">
                                ${isOut 
                                    ? `<span class="font-bold text-red-600 text-xs bg-red-50 border border-red-200 px-2 py-1 rounded-lg mt-2 tracking-wide uppercase">Agotado hoy</span>`
                                    : `<p class="font-black text-brand-600 text-lg">$${item.price}</p>`
                                }
                            </div>
                        </div>
                        ${!isOut ? `<button onclick="addToCart(${item.id})" class="absolute bottom-4 right-4 bg-gray-100 hover:bg-brand-100 text-gray-800 hover:text-brand-600 w-10 h-10 rounded-full flex items-center justify-center active:scale-95 transition-colors shadow-sm"><i class="ph-bold ph-plus text-xl"></i></button>` : ''}
                    </div>`;
                });
                html += `</div>`;
                container.innerHTML += html;
            });
        }

        function addToCart(id) {
            const item = menuData.find(i => i.id === id);
            if(!item || item.outOfStock) return;
            const existing = orderCart.find(i => i.id === id);
            if(existing) { existing.qty++; } else { orderCart.push({...item, qty: 1}); }
            updateCartBtn();
            showToast(`Añadido: ${item.name}`, "success");
        }

        function updateCartBtn() {
            const btn = document.getElementById('cart-float-btn');
            const totalItems = orderCart.reduce((sum, item) => sum + item.qty, 0);
            if(totalItems > 0) {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
                document.getElementById('cart-float-text').innerText = `Tu Pedido (${totalItems})`;
            } else {
                btn.classList.add('hidden');
                btn.classList.remove('flex');
            }
        }

        function openCart() {
            renderCart();
            document.getElementById('cart-modal').classList.remove('hidden');
            document.getElementById('cart-modal').classList.add('flex');
        }

        function closeCart() {
            document.getElementById('cart-modal').classList.add('hidden');
            document.getElementById('cart-modal').classList.remove('flex');
        }

        function changeQty(id, delta) {
            const item = orderCart.find(i => i.id === id);
            if(!item) return;
            item.qty += delta;
            if(item.qty <= 0) { orderCart = orderCart.filter(i => i.id !== id); }
            renderCart();
            updateCartBtn();
            if(orderCart.length === 0) closeCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            container.innerHTML = '';
            let total = 0;
            orderCart.forEach(item => {
                total += item.price * item.qty;
                container.innerHTML += `
                <div class="flex justify-between items-center bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
                    <div class="flex-1 pr-3">
                        <h4 class="font-bold text-gray-900 text-base leading-tight mb-1">${item.name}</h4>
                        <p class="text-brand-600 font-black text-sm">$${item.price}</p>
                    </div>
                    <div class="flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-full px-2 py-1 shadow-inner">
                        <button onclick="changeQty(${item.id}, -1)" class="w-8 h-8 flex justify-center items-center rounded-full text-gray-600 hover:bg-gray-200 active:scale-95 transition-colors"><i class="ph-bold ph-minus"></i></button>
                        <span class="font-black text-base w-5 text-center text-gray-900">${item.qty}</span>
                        <button onclick="changeQty(${item.id}, 1)" class="w-8 h-8 flex justify-center items-center rounded-full text-gray-600 hover:bg-gray-200 active:scale-95 transition-colors"><i class="ph-bold ph-plus"></i></button>
                    </div>
                </div>`;
            });
            document.getElementById('cart-total').innerText = `$${total}`;
        }

        function populateCategorySelect() {
            const select = document.getElementById('admin-category-select');
            const categories = [...new Set(menuData.map(item => item.category))];
            select.innerHTML = '';
            categories.forEach(c => { select.innerHTML += `<option value="${c}">${c}</option>`; });
            select.innerHTML += `<option value="NEW" class="font-bold text-brand-600">+ Crear Nueva Categoría...</option>`;
            checkNewCategory();
        }

        function checkNewCategory() {
            const select = document.getElementById('admin-category-select');
            const newCatInput = document.getElementById('admin-category-new');
            if(select.value === 'NEW') {
                newCatInput.classList.remove('hidden');
                newCatInput.focus();
            } else {
                newCatInput.classList.add('hidden');
            }
        }

        function updateAdminList() {
            const list = document.getElementById('admin-list');
            list.innerHTML = '';
            document.getElementById('admin-total-items').innerText = `${menuData.length} platos`;
            
            [...menuData].sort((a,b)=>a.order-b.order).forEach(item => {
                const isOut = item.outOfStock ? '<span class="text-[10px] bg-red-100 text-red-600 px-1.5 py-0.5 rounded-md font-bold border border-red-200 uppercase tracking-widest">Agotado</span>' : '';
                list.innerHTML += `
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 flex justify-between items-center hover:shadow-md transition-shadow">
                    <div class="flex flex-col flex-1 pr-3">
                        <span class="text-[10px] text-gray-400 font-black uppercase tracking-widest mb-1">${item.category} <span class="text-gray-300">|</span> Ord: ${item.order}</span>
                        <span class="font-black text-gray-800 text-base leading-tight mb-1">${item.name} ${item.featured ? '⭐' : ''}</span>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-black text-brand-600">$${item.price}</span>
                            ${isOut}
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="editDish(${item.id})" class="bg-blue-50 hover:bg-blue-100 text-blue-600 p-3 rounded-xl border border-blue-100 active:scale-95 transition-colors" title="Editar"><i class="ph-bold ph-pencil-simple text-lg"></i></button>
                        <button onclick="deleteDish(${item.id})" class="bg-red-50 hover:bg-red-100 text-red-600 p-3 rounded-xl border border-red-100 active:scale-95 transition-colors" title="Eliminar"><i class="ph-bold ph-trash text-lg"></i></button>
                    </div>
                </div>`;
            });
        }

        function saveDish() {
            let catVal = document.getElementById('admin-category-select').value;
            if(catVal === 'NEW') {
                catVal = document.getElementById('admin-category-new').value.trim();
                if(!catVal) { showToast("Escribe un nombre para la categoría nueva", "error"); return; }
            }

            const name = document.getElementById('admin-name').value.trim();
            const price = document.getElementById('admin-price').value;
            if(!name || !price) { showToast("El nombre y el precio son obligatorios", "error"); return; }

            const dish = {
                id: editingId || Date.now(), 
                category: catVal,
                name: name,
                order: parseInt(document.getElementById('admin-order').value) || 1,
                price: parseFloat(price),
                description: document.getElementById('admin-desc').value.trim(),
                image: document.getElementById('admin-image').value.trim(),
                featured: document.getElementById('admin-featured').checked,
                isVegan: document.getElementById('admin-vegan').checked,
                isGlutenFree: document.getElementById('admin-gf').checked,
                isSpicy: document.getElementById('admin-spicy').checked,
                outOfStock: document.getElementById('admin-outofstock').checked
            };

            if(editingId) {
                menuData = menuData.map(item => item.id === editingId ? dish : item);
            } else {
                menuData.push(dish);
            }

            localStorage.setItem('restaurant_menu_prod', JSON.stringify(menuData));
            showToast(editingId ? "Plato actualizado con éxito" : "Plato guardado con éxito", "success");
            
            resetAdminForm();
            updateAdminList();
            populateCategorySelect();
        }

        function editDish(id) {
            const dish = menuData.find(i => i.id === id);
            if(!dish) return;
            
            editingId = id;
            document.getElementById('admin-form-title').innerHTML = `<i class="ph-fill ph-pencil-circle text-blue-500"></i> Editando: ${dish.name}`;
            
            const select = document.getElementById('admin-category-select');
            if([...select.options].some(o => o.value === dish.category)) {
                select.value = dish.category;
                checkNewCategory();
            } else {
                select.value = 'NEW';
                checkNewCategory();
                document.getElementById('admin-category-new').value = dish.category;
            }

            document.getElementById('admin-name').value = dish.name;
            document.getElementById('admin-order').value = dish.order || 1;
            document.getElementById('admin-price').value = dish.price;
            document.getElementById('admin-desc').value = dish.description;
            document.getElementById('admin-image').value = dish.image || '';
            document.getElementById('admin-featured').checked = dish.featured;
            document.getElementById('admin-vegan').checked = dish.isVegan;
            document.getElementById('admin-gf').checked = dish.isGlutenFree;
            document.getElementById('admin-spicy').checked = dish.isSpicy;
            document.getElementById('admin-outofstock').checked = dish.outOfStock;
            
            document.getElementById('admin-cancel-btn').classList.remove('hidden');
            document.querySelector('#view-admin').scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetAdminForm() {
            editingId = null;
            document.getElementById('admin-form-title').innerHTML = `<i class="ph-fill ph-plus-circle text-brand-500"></i> Agregar Nuevo Plato`;
            document.getElementById('admin-category-new').value = '';
            document.getElementById('admin-name').value = '';
            document.getElementById('admin-order').value = '1';
            document.getElementById('admin-price').value = '';
            document.getElementById('admin-desc').value = '';
            document.getElementById('admin-image').value = '';
            document.getElementById('admin-featured').checked = false;
            document.getElementById('admin-vegan').checked = false;
            document.getElementById('admin-gf').checked = false;
            document.getElementById('admin-spicy').checked = false;
            document.getElementById('admin-outofstock').checked = false;
            document.getElementById('admin-cancel-btn').classList.add('hidden');
            populateCategorySelect();
        }

        function deleteDish(id) {
            if(confirm("¿Estás seguro de que deseas eliminar este plato definitivamente? Esta acción no se puede deshacer.")) {
                menuData = menuData.filter(item => item.id !== id);
                localStorage.setItem('restaurant_menu_prod', JSON.stringify(menuData));
                updateAdminList();
                showToast("Plato eliminado", "error"); // Usamos estilo error para borrar
            }
        }

        function copyWifi() {
            const pass = wifiData.pass;
            // Soporte robusto para copiado en dispositivos móviles
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(pass).then(() => showToast("Contraseña copiada", "success"));
            } else {
                let textArea = document.createElement("textarea");
                textArea.value = pass;
                textArea.style.position = "fixed";
                textArea.style.left = "-999999px";
                textArea.style.top = "-999999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showToast("Contraseña copiada", "success");
                } catch (err) {
                    showToast("Error al copiar", "error");
                }
                textArea.remove();
            }
        }

        function showToast(msg, type="success") {
            const toast = document.createElement('div');
            const color = type === 'success' ? 'bg-gray-900 border-gray-700' : 'bg-red-600 border-red-500';
            const icon = type === 'success' ? 'ph-check-circle' : 'ph-warning-circle';
            
            toast.className = `${color} text-white px-5 py-4 rounded-2xl shadow-[0_10px_25px_rgba(0,0,0,0.3)] flex items-center gap-3 text-sm font-bold opacity-0 transition-all duration-300 transform -translate-y-4 border border-white/10 z-50`;
            toast.innerHTML = `<i class="ph-fill ${icon} text-2xl"></i> ${msg}`;
            
            const container = document.getElementById('toast-container');
            container.appendChild(toast);
            
            requestAnimationFrame(() => { 
                toast.classList.remove('opacity-0', '-translate-y-4'); 
                toast.classList.add('opacity-100', 'translate-y-0'); 
            });
            
            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-4');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Inicialización de la aplicación al cargar
        window.onload = () => { 
            showView('view-home'); 
        }
    </script>
</body>
</html>
